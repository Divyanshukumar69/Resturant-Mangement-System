# Copy this to .env for local development
# On Railway/Render, set these as environment variables in the dashboard

# Server
NODE_ENV=production
PORT=3000

# Security — CHANGE THIS to a strong random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here

# CORS — set to your Railway/Render app URL in production
# Example: https://ngsv6-restaurant.railway.app
ALLOWED_ORIGIN=*

# Database — set to your persistent volume path on Railway/Render
# Example: /app/data/restaurant.db
# Leave empty for local dev (uses restaurant.db in project root)
DB_PATH=

# AI Features (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
